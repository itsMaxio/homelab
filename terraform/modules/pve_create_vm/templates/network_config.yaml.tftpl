version: 2
ethernets:
%{ for interface in interfaces ~}
  ${interface.name}:
    match:
      macaddress: "${lower(interface.mac_address)}"
    set-name: "${interface.name}"
    addresses:
      - "${interface.ip}/${interface.cidr}"
%{ if interface.gateway != null && interface.gateway != "" ~}
    routes:
      - to: default
        via: "${interface.gateway}"
%{ endif ~}
%{ if interface.name == dns_interface_name && (length(dns_servers) > 0 || length(search_domains) > 0) ~}
    nameservers:
%{ if length(dns_servers) > 0 ~}
      addresses:
%{ for dns in dns_servers ~}
        - "${dns}"
%{ endfor ~}
%{ endif ~}
%{ if length(search_domains) > 0 ~}
      search:
%{ for search_domain in search_domains ~}
        - "${search_domain}"
%{ endfor ~}
%{ endif ~}
%{ endif ~}
%{ if interface.mtu != null ~}
    mtu: ${interface.mtu}
%{ endif ~}
%{ endfor ~}