#cloud-config
hostname: ${hostname}
%{ if domain_name != null && domain_name != "" ~}
fqdn: ${hostname}.${domain_name}
%{ endif ~}
manage_etc_hosts: true
%{ if length(users) > 0 ~}

users:
%{ for username, keys in users ~}
  - name: ${username}
    gecos: ${username}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
%{ if length(keys) > 0 ~}
    ssh_authorized_keys:
%{ for key in keys ~}
      - "${key}"
%{ endfor ~}
%{ endif ~}
%{ endfor ~}
%{ endif ~}